node_modules/

.sass-cache/*
*.css.map

# Node.js dependencies
node_modules/      # Directory for Node.js dependencies

# Logs
logs/               # Directory for log files
*.log               # Log files
npm-debug.log*      # Logs from npm
yarn-debug.log*     # Logs from Yarn (debug)
yarn-error.log*     # Logs from Yarn (error)

# Runtime data
pids/               # Process ID files
*.pid               # PID files
*.seed              # Seed files
*.pid.lock          # Lock files

# Directory for temporary files
tmp/                # Temporary files
temp/               # Another common name for temporary directories

# Build files
dist/               # Distribution folder for production builds
build/              # Build folder for production builds

# IDE and editor files
.vscode/            # VSCode workspace settings
.idea/              # IDE-specific settings (e.g., JetBrains)
*.swp               # Swap files created by Vim
*.swo               # Swap files (alternative naming)
*.swn               # Swap files (alternative naming)
*.bak               # Backup files
*~                  # Temporary files generated by some editors

# OS-generated files
.DS_Store           # macOS Finder metadata
Thumbs.db           # Windows Explorer metadata

# Environment variables
.env                # File containing sensitive environment variables

# Cache files
.cache/             # Cache files
.cache-loader/      # Cache loader files

# Test coverage
coverage/           # Directory containing test coverage reports

# Uploads and user-generated content (if applicable)
uploads/            # User-uploaded files or media content

# Miscellaneous
*.gz                # Compressed files


