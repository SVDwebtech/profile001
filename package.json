{
  "name": "profile001",
  "version": "1.0.0",
  "type": "module",
  "description": "a landing/profile page for Schalk van Dyk, a web developer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "sass-main": "sass --watch sass/main.scss:public/css/style.css",
    "sass-portfolio": "sass --watch sass/pages/_portfolio.scss:public/portfolio/styles/portfolio.css",
    "sass-404": "sass --watch sass/pages/_404.scss:public/404/styles/404.css",
    "sass-error": "sass --watch sass/pages/_error.scss:public/error/styles/error.css",
    "server": "nodemon server.js",
    "dev": "npm-run-all --parallel server sass-main sass-portfolio sass-404 sass-error",
    "compile:sass": "sass sass/main.scss css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.comp.css -o css/style.prefix.css",
    "compress:css": "sass css/style.prefix.css css/style.css --style=compressed",
    "build:css": "npm-run-all compile:sass prefix:css compress:css"
  },
  "nodemonConfig": {
    "watch": ["server.js", "src/"],
    "ext": "js,ejs,json",
    "ignore": ["node_modules/"]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SVDwebtech/profile001.git"
  },
  "author": "Schalk van Dyk",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SVDwebtech/profile001/issues"
  },
  "homepage": "https://github.com/SVDwebtech/profile001#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "browser-sync": "^3.0.3",
    "concat": "^1.0.3",
    "faker": "^5.5.3",
    "nodemon": "^3.1.7",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^9.1.0",
    "sass": "^1.81.0"
  },
  "dependencies": {
    "axios": "^1.7.8",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.4"
  }
}
