<!DOCTYPE html>
<html lang="en">
<head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Page Not Found</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;600;700;900&display=swap"
            rel="stylesheet">
      <link rel="stylesheet" href="/404/styles/404.css">
</head>
<body>
      <div class="page404Container">
            <h1 class="page404Container__headingH1 headingH1 headingH1--page404Heading">
                  <span class="page404Container__headingH1 headingH1 headingH1--page404PrimaryHeading">Oops!</span> 
                  <span class="page404Container__headingH1 headingH1 headingH1--page404SecondaryHeading">This page does not exist.</span>
            </h1>
            <h2 class="page404Container__headingH2 headingH2 headingH2--page404ErrorCode"><strong>Error Code: 404</strong> </br>(Page Not Found)</h2>
            <p class="page404Container__paragraph paragraph paragraph--page404Container">Sorry, we can't seem to find the page you are looking for.</p>
            <a btn btn--404HomeBtn href="/">Return Home</a>
      </div>
      
</body>
</html>
